DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
PORT=3000
NODE_ENV=development
# Obligatorio: generar fuera del repositorio, mínimo 32 bytes aleatorios.
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=mertel-api
JWT_AUDIENCE=mertel-access
AUTH_REFRESH_EXPIRES_IN=7d
# En development (o NODE_ENV ausente) se usan localhost:5173 y lax si faltan estas dos variables.
# En test y production ambas variables siguen siendo obligatorias; valores vacíos son inválidos.
# Valores SameSite permitidos: lax, strict o none; se acepta Lax/None y se normaliza a minúsculas.
# HTTP local: NODE_ENV=development y AUTH_COOKIE_SAME_SITE=lax; Secure=false.
# Usar el mismo host en ambos servicios (localhost o 127.0.0.1), aunque cambie el puerto.
# Producción FINAL: frontend https://mertelimportaciones.com
# y API https://api.mertelimportaciones.com (MySQL interna, sin acceso público).
# Configuración de producción indicada para MERTEL: AUTH_COOKIE_SAME_SITE=None.
# Para producción sustituir estos tres valores:
# NODE_ENV=production
# AUTH_COOKIE_SAME_SITE=None
# FRONTEND_URL=https://mertelimportaciones.com
# No usar la URL de la API como origen del frontend ni agregar otros orígenes de producción.
# Secure=true y HttpOnly=true se aplican automáticamente en producción; ambos servicios usan HTTPS.
# Se conserva la validación de none: requiere Secure y solo se permite en producción.
# HttpOnly siempre es true; Secure siempre es true en producción, sin ENV para desactivarlo.
AUTH_COOKIE_SAME_SITE=lax
# Desarrollo: orígenes exactos separados por coma. Producción: únicamente el frontend indicado arriba.
# Para cookies entre orígenes, el frontend debe usar credentials: "include" (fetch)
# o withCredentials: true (Axios), y su origen debe aparecer en FRONTEND_URL.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Número de proxies de confianza; 0 para conexión directa.
TRUST_PROXY_HOPS=0
# WhatsApp: solo MOCK en esta fase. Clave AES-256 de 64 caracteres hexadecimales.
# Obligatoria únicamente para guardar/leer credenciales; nunca exponer en frontend.
WHATSAPP_ENCRYPTION_KEY=
