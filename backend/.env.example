DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
PORT=3000
NODE_ENV=development
# Obligatorio: generar fuera del repositorio, mínimo 32 bytes aleatorios.
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=mertel-api
JWT_AUDIENCE=mertel-access
AUTH_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_SAME_SITE=lax
# Orígenes exactos separados por coma; producción debe usar HTTPS.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Número de proxies de confianza; 0 para conexión directa.
TRUST_PROXY_HOPS=0
