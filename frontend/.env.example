# Producción: frontend https://mertelimportaciones.com; API HTTPS del mismo site.
# Obligatorio en producción: se incorpora al build. Sin este valor o con HTTP, el cliente rechaza la configuración.
# Usar un origen sin credenciales, query ni fragmento; se admite /api como prefijo opcional.
# /api corresponde al prefijo de las rutas del backend.
VITE_API_URL=https://api.mertelimportaciones.com
# Desarrollo: definir VITE_API_URL=http://localhost:3000 en .env.local (ignorado por Git).
# apiClient añade /api y utiliza withCredentials para la cookie HttpOnly del backend.
